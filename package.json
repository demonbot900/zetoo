    "build-only": "vite build",
    "build:template": "node scripts/build-default-template.mjs",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
