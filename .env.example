# Google sign-in
#
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials
#
# Add these under "Authorised JavaScript origins":
#   http://localhost:5173
#   http://localhost:3001
#
# No redirect URI and no client secret are needed: Zetoo uses the Google
# Identity Services ID-token flow, which is verified server-side.
#
# Copy this file to .env, paste the ID below, then restart the API.
GOOGLE_CLIENT_ID=

# Optional overrides
# PORT=3001
# ZETOO_DB=C:/pfad/zu/zetoo.db
